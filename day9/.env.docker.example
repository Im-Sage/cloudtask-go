# 整个启动阶段的时间预算
STARTUP_TIMEOUT=15s
SHUTDOWN_TIMEOUT=10s
HEALTH_CHECK_TIMEOUT=1s
LOG_LEVEL=info


HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s


# PostgreSQL 连接池与连接检查
DATABASE_URL=postgres://app:******@db:5432/cloudtask?sslmode=disable
PG_MAX_CONNS=3
PG_MIN_CONNS=1
PG_PING_TIMEOUT=5s


# Redis 连接检查
REDIS_PING_TIMEOUT=3s
REDIS_ADDR=redis:6379
REDIS_USERNAME=default
REDIS_PASSWORD=*****
REDIS_DB=0

# 本次部署版本
IMAGE_TAG=v2.3.4